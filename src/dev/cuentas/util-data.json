{
 "faqs": [
  {
   "id": "127c8587-0222-4b14-a30e-5da5df8497b1",
   "question": "¿Cómo se obtiene la información?",
   "answer": "Tienen la opción de darnos acceso para bajarla, mandarla por correo o whatsapp al igual que subirla directo a la plataforma."
  },
  {
   "id": "2c6bcb47-feb7-45be-8154-d36251908ab2",
   "question": "¿Las invitaciones y diseños libres en cuanto tiempo se entregan?",
   "answer": "Todos los registros antes de las 11 am horario centro de México se entregan el mismo día de Lunes a Viernes, si el registro es posterior al horario la entrega se hace el día siguiente."
  },
  {
   "id": "31f11d6f-d562-4018-952c-a98db9e1261b",
   "question": "¿Se puede descargar en varios dispositivos?",
   "answer": "Si, son ilimitados los accesos."
  },
  {
   "id": "c2cd2ffc-b161-45fa-81f9-a7dbbde13081",
   "question": "¿La información se actualiza?",
   "answer": "Por ahora la información siempre es al cierre de mes, estamos trabajando en poder actualizar semanalmente."
  },
  {
   "id": "f0cdad18-55df-4b56-9340-28741def6b57",
   "question": "¿Los diseños cambian?",
   "answer": "Si, cada mes los diseños son nuevos."
  }
 ],
